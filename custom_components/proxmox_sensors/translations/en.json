{
  "config": {
    "step": {
      "user": {
        "title": "1. Server Connection",
        "description": "Enter your Proxmox server address. The port is managed automatically (8006 for PVE / 8007 for PBS).",
        "data": {
          "host": "Server Address (IP or FQDN)",
          "platform_type": "Server Type"
        }
      },
      "auth_method": {
        "title": "2. Authentication Method",
        "description": "Select authentication method. API Tokens are required for PBS and recommended for PVE.",
        "data": {
          "use_token": "Use API Token (Recommended)"
        }
      },
      "credentials_pve": {
        "title": "3. Access Credentials — Proxmox VE",
        "description": "Enter your PVE connection details.",
        "data": {
          "user": "User (e.g., root@pam)",
          "password": "Password",
          "token_id": "Token ID (without user@pve!)",
          "token_secret": "Token Secret",
          "auto_detect_node": "Auto-detect node from host IP",
          "enable_lm_sensors": "Enable hardware sensors & temperatures",
          "enable_cluster": "Enable cluster-wide monitoring",
          "verify_ssl": "Verify SSL Certificate"
        }
      },
      "credentials_pbs": {
        "title": "3. Access Credentials — Proxmox Backup Server",
        "description": "Enter your PBS connection details.",
        "data": {
          "user": "User (e.g., admin@pbs)",
          "password": "Password",
          "token_id": "Token ID",
          "token_secret": "Token Secret",
          "verify_ssl": "Verify SSL Certificate"
        }
      },
      "credentials_cluster": {
        "title": "3. Access Credentials — Proxmox Cluster",
        "description": "Enter credentials to connect to the cluster. Uses the same API as PVE (port 8006).",
        "data": {
          "user": "User (e.g., root@pam)",
          "password": "Password",
          "token_id": "Token ID (without user@pve!)",
          "token_secret": "Token Secret",
          "verify_ssl": "Verify SSL Certificate"
        }
      },
      "select_node": {
        "title": "4. Select Node",
        "description": "Select the Proxmox node to monitor.",
        "data": {
          "node": "Node"
        }
      },
      "select_resources": {
        "title": "5. Resource Selection",
        "description": "Select which resources should be monitored and exposed as entities in Home Assistant.",
        "data": {
          "vms": "Virtual Machines (VM)",
          "cts": "Containers (LXC)",
          "storage": "Storage",
          "enable_physical_disks": "Enable physical disk monitoring",
          "enable_node_controls": "Enable node power controls"
        }
      }
    },
    "error": {
      "cannot_connect": "Connection error. Check the server address.",
      "invalid_auth": "Authentication failed. Check credentials or token permissions.",
      "unknown": "Unexpected error. Check Home Assistant logs."
    },
    "abort": {
      "already_configured": "This node is already configured.",
      "no_data": "No cluster data received. Check your configuration.",
      "cluster_no_options": "Cluster settings are managed from the PVE node configuration."
    }
  },
