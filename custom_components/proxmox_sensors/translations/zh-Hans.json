{
  "config": {
    "step": {
      "user": {
        "title": "1. 服务器连接",
        "description": "请输入 Proxmox 服务器地址。端口会自动管理（PVE 使用 8006 / PBS 使用 8007）。",
        "data": {
          "host": "服务器地址（IP 或 FQDN）",
          "platform_type": "服务器类型"
        }
      },
      "auth_method": {
        "title": "2. 认证方式",
        "description": "请选择认证方式。PBS 必须使用 API Token，PVE 推荐使用 API Token。",
        "data": {
          "use_token": "使用 API Token（推荐）"
        }
      },
      "credentials_pve": {
        "title": "3. 访问凭据 — Proxmox VE",
        "description": "请输入 PVE 连接信息。",
        "data": {
          "user": "用户（例如 root@pam）",
          "password": "密码",
          "token_id": "Token ID（不包含 user@pve!）",
          "token_secret": "Token Secret",
          "auto_detect_node": "从主机 IP 自动检测节点",
          "enable_lm_sensors": "启用硬件传感器与温度监控",
          "enable_cluster": "启用集群级监控",
          "verify_ssl": "验证 SSL 证书"
        }
      },
      "credentials_pbs": {
        "title": "3. 访问凭据 — Proxmox Backup Server",
        "description": "请输入 PBS 连接信息。",
        "data": {
          "user": "用户（例如 admin@pbs）",
          "password": "密码",
          "token_id": "Token ID",
          "token_secret": "Token Secret",
          "verify_ssl": "验证 SSL 证书"
        }
      },
      "credentials_cluster": {
        "title": "3. 访问凭据 — Proxmox 集群",
        "description": "请输入用于连接集群的凭据。集群使用与 PVE 相同的 API（端口 8006）。",
        "data": {
          "user": "用户（例如 root@pam）",
          "password": "密码",
          "token_id": "Token ID（不包含 user@pve!）",
          "token_secret": "Token Secret",
          "verify_ssl": "验证 SSL 证书"
        }
      },
      "select_node": {
        "title": "4. 选择节点",
        "description": "请选择要监控的 Proxmox 节点。",
        "data": {
          "node": "节点"
        }
      },
      "select_resources": {
        "title": "5. 资源选择",
        "description": "请选择要在 Home Assistant 中监控并公开为实体的资源。",
        "data": {
          "vms": "虚拟机（VM）",
          "cts": "容器（LXC）",
          "storage": "存储",
          "enable_physical_disks": "启用物理磁盘监控",
          "enable_node_controls": "启用节点电源控制"
        }
      }
    },
    "error": {
