{
  "config": {
    "step": {
      "user": {
        "title": "1. Serververbindung",
        "description": "Gib die Adresse deines Proxmox-Servers ein. Der Port wird automatisch verwaltet (8006 für PVE / 8007 für PBS).",
        "data": {
          "host": "Serveradresse (IP oder FQDN)",
          "platform_type": "Servertyp"
        }
      },
      "auth_method": {
        "title": "2. Authentifizierungsmethode",
        "description": "Wähle die Authentifizierungsmethode. API-Token sind für PBS erforderlich und für PVE empfohlen.",
