          "node": "Knoten"
        }
      },
      "select_resources": {
        "title": "5. Ressourcenauswahl",
        "description": "Wähle aus, welche Ressourcen überwacht und als Entitäten in Home Assistant verfügbar sein sollen.",
        "data": {
          "vms": "Virtuelle Maschinen (VM)",
          "cts": "Container (LXC)",
          "storage": "Speicher",
          "enable_physical_disks": "Überwachung physischer Festplatten aktivieren",
          "enable_node_controls": "Knoten-Energiesteuerung aktivieren"
