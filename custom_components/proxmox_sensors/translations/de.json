          "use_token": "API-Token verwenden (Empfohlen)"
        }
      },
      "credentials_pve": {
        "title": "3. Zugangsdaten — Proxmox VE",
        "description": "Gib die Verbindungsdetails für dein PVE ein.",
        "data": {
          "user": "Benutzer (z.B. root@pam)",
          "password": "Passwort",
          "token_id": "Token-ID (ohne Benutzer@pve!)",
          "token_secret": "Token-Geheimnis",
          "auto_detect_node": "Knoten automatisch von Host-IP erkennen",
          "enable_lm_sensors": "Hardware-Sensoren und Temperaturen aktivieren",
          "enable_cluster": "Cluster-weite Überwachung aktivieren",
          "verify_ssl": "SSL-Zertifikat überprüfen"
        }
      },
      "credentials_pbs": {
        "title": "3. Zugangsdaten — Proxmox Backup Server",
        "description": "Gib die Verbindungsdetails für dein PBS ein.",
        "data": {
          "user": "Benutzer (z.B. admin@pbs)",
          "password": "Passwort",
          "token_id": "Token-ID",
          "token_secret": "Token-Geheimnis",
          "verify_ssl": "SSL-Zertifikat überprüfen"
        }
      },
      "credentials_cluster": {
        "title": "3. Zugangsdaten — Proxmox Cluster",
        "description": "Gib die Zugangsdaten für die Verbindung zum Cluster ein. Verwendet dieselbe API wie PVE (Port 8006).",
        "data": {
          "user": "Benutzer (z.B. root@pam)",
          "password": "Passwort",
          "token_id": "Token-ID (ohne Benutzer@pve!)",
          "token_secret": "Token-Geheimnis",
          "verify_ssl": "SSL-Zertifikat überprüfen"
        }
      },
      "select_node": {
        "title": "4. Knoten auswählen",
        "description": "Wähle den zu überwachenden Proxmox-Knoten.",
