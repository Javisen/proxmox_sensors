{
  "config": {
    "step": {
      "user": {
        "title": "1. Conexión al Servidor",
        "description": "Introduce la dirección de tu servidor Proxmox. El puerto se gestiona automáticamente (8006 para PVE / 8007 para PBS).",
        "data": {
          "host": "Dirección del Servidor (IP o FQDN)",
          "platform_type": "Tipo de Servidor"
        }
      },
      "auth_method": {
        "title": "2. Método de Autenticación",
        "description": "Selecciona el método de autenticación. Los Tokens de API son obligatorios para PBS y recomendados para PVE.",
        "data": {
          "use_token": "Usar Token de API (Recomendado)"
        }
      },
      "credentials_pve": {
        "title": "3. Credenciales de Acceso — Proxmox VE",
        "description": "Introduce los detalles de conexión de tu PVE.",
        "data": {
          "user": "Usuario (ej. root@pam)",
          "password": "Contraseña",
          "token_id": "ID del Token (sin usuario@pve!)",
          "token_secret": "Secreto del Token",
          "auto_detect_node": "Detectar nodo automáticamente desde la IP del host",
          "enable_lm_sensors": "Activar sensores de hardware y temperaturas",
          "enable_cluster": "Activar monitorización de todo el clúster",
          "verify_ssl": "Verificar Certificado SSL"
        }
      },
      "credentials_pbs": {
        "title": "3. Credenciales de Acceso — Proxmox Backup Server",
        "description": "Introduce los detalles de conexión de tu PBS.",
        "data": {
          "user": "Usuario (ej. admin@pbs)",
          "password": "Contraseña",
          "token_id": "ID del Token",
          "token_secret": "Secreto del Token",
          "verify_ssl": "Verificar Certificado SSL"
        }
      },
      "credentials_cluster": {
        "title": "3. Credenciales de Acceso — Clúster Proxmox",
        "description": "Introduce las credenciales para conectar al clúster. Usa la misma API que PVE (puerto 8006).",
        "data": {
          "user": "Usuario (ej. root@pam)",
          "password": "Contraseña",
          "token_id": "ID del Token (sin usuario@pve!)",
          "token_secret": "Secreto del Token",
          "verify_ssl": "Verificar Certificado SSL"
        }
      },
      "select_node": {
        "title": "4. Seleccionar Nodo",
        "description": "Selecciona el nodo Proxmox a monitorizar.",
        "data": {
          "node": "Nodo"
        }
      },
      "select_resources": {
        "title": "5. Selección de Recursos",
        "description": "Selecciona qué recursos deben ser monitorizados y expuestos como entidades en Home Assistant.",
        "data": {
          "vms": "Máquinas Virtuales (VM)",
          "cts": "Contenedores (LXC)",
          "storage": "Almacenamiento",
          "enable_physical_disks": "Activar monitorización de discos físicos",
          "enable_node_controls": "Activar controles de energía del nodo"
        }
      }
    },
    "error": {
      "cannot_connect": "Error de conexión. Comprueba la dirección del servidor.",
      "invalid_auth": "Error de autenticación. Comprueba las credenciales o los permisos del token.",
      "unknown": "Error inesperado. Revisa los logs de Home Assistant."
    },
    "abort": {
      "already_configured": "Este nodo ya está configurado.",
      "no_data": "No se recibieron datos del clúster. Comprueba tu configuración.",
      "cluster_no_options": "La configuración del clúster se gestiona desde la configuración del nodo PVE."
