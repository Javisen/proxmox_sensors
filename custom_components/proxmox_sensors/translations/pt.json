{
  "config": {
    "step": {
      "user": {
        "title": "1. Conexão ao Servidor",
        "description": "Introduza o endereço do seu servidor Proxmox. A porta é gerida automaticamente (8006 para PVE / 8007 para PBS).",
        "data": {
          "host": "Endereço do Servidor (IP ou FQDN)",
          "platform_type": "Tipo de Servidor"
        }
      },
      "auth_method": {
        "title": "2. Método de Autenticação",
        "description": "Selecione o método de autenticação. Tokens API são obrigatórios para PBS e recomendados para PVE.",
        "data": {
          "use_token": "Usar Token API (Recomendado)"
        }
      },
      "credentials_pve": {
        "title": "3. Credenciais de Acesso — Proxmox VE",
        "description": "Introduza os detalhes de conexão do seu PVE.",
        "data": {
          "user": "Utilizador (ex. root@pam)",
          "password": "Palavra-passe",
          "token_id": "ID do Token (sem utilizador@pve!)",
          "token_secret": "Segredo do Token",
          "auto_detect_node": "Detetar nó automaticamente pelo IP do host",
          "enable_lm_sensors": "Ativar sensores de hardware e temperaturas",
          "enable_cluster": "Ativar monitorização de todo o cluster",
          "verify_ssl": "Verificar Certificado SSL"
        }
      },
      "credentials_pbs": {
        "title": "3. Credenciais de Acesso — Proxmox Backup Server",
        "description": "Introduza os detalhes de conexão do seu PBS.",
        "data": {
          "user": "Utilizador (ex. admin@pbs)",
          "password": "Palavra-passe",
          "token_id": "ID do Token",
          "token_secret": "Segredo do Token",
          "verify_ssl": "Verificar Certificado SSL"
        }
      },
      "credentials_cluster": {
        "title": "3. Credenciais de Acesso — Cluster Proxmox",
        "description": "Introduza as credenciais para conectar ao cluster. Utiliza a mesma API que o PVE (porta 8006).",
        "data": {
          "user": "Utilizador (ex. root@pam)",
          "password": "Palavra-passe",
          "token_id": "ID do Token (sem utilizador@pve!)",
          "token_secret": "Segredo do Token",
          "verify_ssl": "Verificar Certificado SSL"
        }
      },
      "select_node": {
        "title": "4. Selecionar Nó",
        "description": "Selecione o nó Proxmox a monitorizar.",
        "data": {
          "node": "Nó"
        }
      },
      "select_resources": {
        "title": "5. Seleção de Recursos",
        "description": "Selecione quais recursos devem ser monitorizados e expostos como entidades no Home Assistant.",
        "data": {
          "vms": "Máquinas Virtuais (VM)",
          "cts": "Contentores (LXC)",
          "storage": "Armazenamento",
          "enable_physical_disks": "Ativar monitorização de discos físicos",
          "enable_node_controls": "Ativar controlos de energia do nó"
        }
      }
    },
    "error": {
      "cannot_connect": "Erro de conexão. Verifique o endereço do servidor.",
      "invalid_auth": "Falha na autenticação. Verifique as credenciais ou permissões do token.",
