---
import NavIcon from "../../../components/NavIcon.astro";
import Overview from "../../../components/documentation/cluster/overview.md";
import QuorumNodes from "../../../components/documentation/cluster/quorum-nodes.md";
import Resources from "../../../components/documentation/cluster/resources.md";
import Guests from "../../../components/documentation/cluster/guests.md";
import HighAvailability from "../../../components/documentation/cluster/high-availability.md";
import TasksDiagnostics from "../../../components/documentation/cluster/tasks-diagnostics.md";
import BackupHealth from "../../../components/documentation/cluster/backup-health.md";
import Troubleshooting from "../../../components/documentation/cluster/troubleshooting.md";
import { getDocumentationCategory } from "../../../data/documentation";
import { navigationItems } from "../../../data/navigation";
import DocumentationLayout from "../../../layouts/DocumentationLayout.astro";

const category = getDocumentationCategory("cluster");
const sections = [
  { id: "overview", ...category.topics[0], content: Overview },
  { id: "quorum-nodes", ...category.topics[1], content: QuorumNodes },
  { id: "resources", ...category.topics[2], content: Resources },
  { id: "guests", ...category.topics[3], content: Guests },
  { id: "high-availability", ...category.topics[4], content: HighAvailability },
  { id: "tasks-diagnostics", ...category.topics[5], content: TasksDiagnostics },
  { id: "backup-health", ...category.topics[6], content: BackupHealth },
  { id: "troubleshooting", ...category.topics[7], content: Troubleshooting },
];
const repositoryUrl = navigationItems.find((item) => item.label === "GitHub")?.href;
if (!repositoryUrl) throw new Error("Canonical integration repository link is missing");
const issuesUrl = `${repositoryUrl}/issues`;
---

<DocumentationLayout title="Cluster Documentation" description={category.introduction} section="Documentation">
  <div class="cluster-guide">
    <nav id="cluster-index" class="getting-started-index" aria-labelledby="cluster-index-title">
      <div class="documentation-section-heading">
        <div>
          <p>On this page</p>
          <h2 id="cluster-index-title">Explore Cluster</h2>
        </div>
        <span>8 sections</span>
      </div>

      <ol class="documentation-topic-grid getting-started-index__list">
        {sections.map((section, index) => (
          <li>
            <a class="documentation-topic-card getting-started-index__link" href={`#${section.id}`}>
              <span class="documentation-topic-card__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span>
                <strong>{section.title}</strong>
                <span>{section.description}</span>
              </span>
              <span class="documentation-topic-card__icon" aria-hidden="true">
                <NavIcon name={category.icon} size={17} />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="getting-started-articles">
      {sections.map((section) => {
        const Content = section.content;
        return (
          <section id={section.id} class="getting-started-section" aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <Content />
            {section.id === "troubleshooting" && (
              <p>
                If the problem persists after these checks, use the project's{" "}
                <a href={issuesUrl}>GitHub issue tracker</a>.
              </p>
            )}
            <a class="getting-started-section__back" href="#cluster-index">↑ Back to top</a>
          </section>
        );
      })}
    </div>
  </div>
</DocumentationLayout>
