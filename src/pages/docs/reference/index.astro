---
import NavIcon from "../../../components/NavIcon.astro";
import ReferenceGuidance from "../../../components/documentation/ReferenceGuidance.astro";
import ReferenceGroups from "../../../components/documentation/ReferenceGroups.astro";
import pdmDatacenterMonitoring from "../../../components/documentation/pdm/datacenter-monitoring.md?raw";
import pdmOverview from "../../../components/documentation/pdm/overview.md?raw";
import pdmRemotes from "../../../components/documentation/pdm/remotes.md?raw";
import pdmUpdates from "../../../components/documentation/pdm/updates.md?raw";
import { getDocumentationCategory } from "../../../data/documentation";
import {
  ctActionCount,
  ctEntryCount,
  ctGroups,
  backupReplicationEntryCount,
  backupReplicationGroups,
  clusterSensorEntryCount,
  clusterSensorGroups,
  hardwareMemoryEntryCount,
  hardwareMemoryGroups,
  identityAvailabilityEntryCount,
  identityAvailabilityGroups,
  pbsMaintenanceEntryCount,
  pbsMaintenanceGroups,
  pbsServerDatastoreEntryCount,
  pbsServerDatastoreGroups,
  pveNodeEntryCount,
  pveNodeGroups,
  storageDisksZfsEntryCount,
  storageDisksZfsGroups,
  troubleshootingEntryCount,
  troubleshootingGroups,
  vmActionCount,
  vmCtEntryCount,
  vmEntryCount,
  vmGroups,
} from "../../../data/reference";
import { buildReferenceSearchIndex, extractPdmReferenceEntries } from "../../../data/referenceSearch.mjs";
import { defaultLocale, isLocale, localizePath } from "../../../i18n/config";
import { translate } from "../../../i18n/content";
import { referenceSearchAliases, referenceSearchCopy } from "../../../i18n/referenceSearch";
import DocumentationLayout from "../../../layouts/DocumentationLayout.astro";
import "../../../styles/reference.css";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const category = getDocumentationCategory("reference");
const categoryIds = [
  "pve-node",
  "hardware-memory",
  "vm-ct",
  "storage-disks-zfs",
  "pbs-server-datastores",
  "pbs-maintenance-actions",
  "cluster-sensors",
  "backup-replication",
  "entities-devices-availability",
  "troubleshooting",
];
if (category.topics.length !== categoryIds.length) throw new Error("Reference category map is incomplete");
const categories = category.topics.map((topic, index) => ({ ...topic, id: categoryIds[index] }));
const referenceSearchIndex = buildReferenceSearchIndex([
  { module: "PVE", sectionId: "pve-node", groups: pveNodeGroups },
  { module: "PVE", sectionId: "hardware-memory", groups: hardwareMemoryGroups },
  { module: "PVE", sectionId: "vm-ct", groups: vmGroups },
  { module: "PVE", sectionId: "vm-ct", groups: ctGroups },
  { module: "PVE", sectionId: "storage-disks-zfs", groups: storageDisksZfsGroups },
  { module: "PBS", sectionId: "pbs-server-datastores", groups: pbsServerDatastoreGroups },
  { module: "PBS", sectionId: "pbs-maintenance-actions", groups: pbsMaintenanceGroups },
  { module: "CLUSTER", sectionId: "cluster-sensors", groups: clusterSensorGroups },
  { module: "CLUSTER", sectionId: "backup-replication", groups: backupReplicationGroups },
]);
const pdmPath = localizePath("/docs/pdm/", locale, baseUrl);
const pdmSearchIndex = extractPdmReferenceEntries([
  { source: pdmOverview, href: pdmPath, group: "PDM Overview" },
  { source: pdmDatacenterMonitoring, href: `${pdmPath}#datacenter-monitoring`, group: "Datacenter Monitoring" },
  { source: pdmRemotes, href: `${pdmPath}#remotes`, group: "Remotes" },
  { source: pdmUpdates, href: `${pdmPath}#updates`, group: "Updates" },
]);
const searchIndex = [...referenceSearchIndex, ...pdmSearchIndex].map((entry) => ({
  ...entry,
  label: translate(locale, entry.name),
  groupLabel: translate(locale, entry.group),
}));
const searchCopy = referenceSearchCopy(locale);
const searchAliases = referenceSearchAliases(locale);
---

<DocumentationLayout title="Reference" description={category.introduction} section="Documentation">
  <div class="reference-guide">
    <div class="reference-search" role="search">
      <label for="reference-search-input">{searchCopy.label}</label>
      <div class="reference-search__control">
        <input
          id="reference-search-input"
          type="search"
          placeholder={searchCopy.placeholder}
          autocomplete="off"
          aria-autocomplete="list"
          aria-controls="reference-suggestions"
          aria-describedby="reference-search-help reference-search-status"
          aria-expanded="false"
          role="combobox"
        />
        <div class="reference-suggestions" data-reference-suggestions hidden>
          <ul id="reference-suggestions" role="listbox" aria-label={searchCopy.suggestions}></ul>
          <p id="reference-empty" class="reference-empty" hidden>{searchCopy.noMatches}</p>
        </div>
      </div>
      <p id="reference-search-help">{searchCopy.help}</p>
      <p id="reference-search-status" class="reference-search__status" role="status" aria-live="polite">
        {searchIndex.length} {searchCopy.results}
      </p>
    </div>

    <nav id="reference-index" class="reference-index" aria-labelledby="reference-index-title">
      <div class="documentation-section-heading">
        <div>
          <p>On this page</p>
          <h2 id="reference-index-title">Browse Reference</h2>
        </div>
        <span>10 categories</span>
      </div>
      <ol class="reference-index__list">
        {categories.map((item, index) => (
          <li data-reference-index-item={item.id}>
            <a class="reference-index__link" href={`#${item.id}`}>
              <span class="reference-index__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span>{item.title}</span>
              <NavIcon name={category.icon} size={15} />
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="reference-sections">
      <section id="pve-node" class="reference-section" aria-labelledby="pve-node-title">
        <div class="reference-section__heading">
          <h2 id="pve-node-title">PVE Node Sensors</h2>
          <span>{pveNodeEntryCount} entries</span>
        </div>
        <p class="reference-section__intro">Entities attached to a Proxmox VE node. Conditional entries appear only when the relevant option or data is available.</p>
        <ReferenceGroups groups={pveNodeGroups} module="PVE" sectionId="pve-node" />
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>

      <section id="hardware-memory" class="reference-section" aria-labelledby="hardware-memory-title">
        <div class="reference-section__heading">
          <h2 id="hardware-memory-title">Hardware & Memory</h2>
          <span>{hardwareMemoryEntryCount} entries</span>
        </div>
        <p class="reference-section__intro">Hardware monitoring must be enabled and compatible sidecar or lm-sensors data must be available. Exact dynamic names and quantities vary with the monitored system.</p>
        <ReferenceGroups groups={hardwareMemoryGroups} module="PVE" sectionId="hardware-memory" />
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>

      <section id="vm-ct" class="reference-section" aria-labelledby="vm-ct-title">
        <div class="reference-section__heading">
          <h2 id="vm-ct-title">VM & CT</h2>
          <span>{vmCtEntryCount} entries</span>
        </div>
        <p class="reference-section__intro">Sensors are created for virtual machines and containers selected for detailed monitoring. Controls appear when their corresponding guest-control features are enabled.</p>
        <aside class="reference-identity-note">
          <strong>Migration identity</strong>
          <p>In a configured cluster, monitored VM and CT entities can retain their Home Assistant identity when the guest migrates between nodes.</p>
        </aside>
        <div class="reference-resource">
          <div class="reference-resource__heading">
            <h3>Virtual Machines</h3>
            <span>{vmEntryCount} sensors · {vmActionCount} actions</span>
          </div>
          <ReferenceGroups groups={vmGroups} module="PVE" sectionId="vm-ct" headingLevel="h4" />
        </div>
        <div class="reference-resource">
          <div class="reference-resource__heading">
            <h3>Containers</h3>
            <span>{ctEntryCount} sensors · {ctActionCount} actions</span>
          </div>
          <ReferenceGroups groups={ctGroups} module="PVE" sectionId="vm-ct" headingLevel="h4" />
        </div>
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>

      <section id="storage-disks-zfs" class="reference-section" aria-labelledby="storage-disks-zfs-title">
        <div class="reference-section__heading">
          <h2 id="storage-disks-zfs-title">Storage, Disks & ZFS</h2>
          <span>{storageDisksZfsEntryCount} entries</span>
        </div>
        <p class="reference-section__intro">Storage entities follow selected PVE resources, while physical disks, mounted disks and ZFS pools depend on the corresponding detected data.</p>
        <ReferenceGroups groups={storageDisksZfsGroups} module="PVE" sectionId="storage-disks-zfs" />
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>

      <section id="pbs-server-datastores" class="reference-section" aria-labelledby="pbs-server-datastores-title">
        <div class="reference-section__heading">
          <h2 id="pbs-server-datastores-title">PBS Server & Datastores</h2>
          <span>{pbsServerDatastoreEntryCount} entries</span>
        </div>
        <p class="reference-section__intro">Server-level status and task entities are accompanied by a dynamic entity family for each discovered PBS datastore.</p>
        <ReferenceGroups groups={pbsServerDatastoreGroups} module="PBS" sectionId="pbs-server-datastores" />
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>

      <section id="pbs-maintenance-actions" class="reference-section" aria-labelledby="pbs-maintenance-actions-title">
        <div class="reference-section__heading">
          <h2 id="pbs-maintenance-actions-title">PBS Maintenance & Actions</h2>
          <span>{pbsMaintenanceEntryCount} entries</span>
        </div>
        <p class="reference-section__intro">Maintenance status and datastore actions reflect discovered datastores and, where required, their matched jobs.</p>
        <aside class="reference-identity-note">
          <strong>Literal state</strong>
          <p>The current implementation can expose <code>Iniciado</code> as a GC Status state. Reference preserves that implementation value without translating it.</p>
        </aside>
        <ReferenceGroups groups={pbsMaintenanceGroups} module="PBS" sectionId="pbs-maintenance-actions" />
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>

      <section id="cluster-sensors" class="reference-section" aria-labelledby="cluster-sensors-title">
        <div class="reference-section__heading">
          <h2 id="cluster-sensors-title">Cluster Sensors</h2>
          <span>{clusterSensorEntryCount} entries</span>
        </div>
        <p class="reference-section__intro">Cluster-wide entities combine quorum, node availability, resources, guests, storage, firewall and HA data.</p>
        <ReferenceGroups groups={clusterSensorGroups} module="CLUSTER" sectionId="cluster-sensors" />
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>

      <section id="backup-replication" class="reference-section" aria-labelledby="backup-replication-title">
        <div class="reference-section__heading">
          <h2 id="backup-replication-title">Backup & Replication</h2>
          <span>{backupReplicationEntryCount} entries</span>
        </div>
        <p class="reference-section__intro">Cluster backup health and replication entities appear only when their corresponding jobs and runtime data apply.</p>
        <ReferenceGroups groups={backupReplicationGroups} module="CLUSTER" sectionId="backup-replication" />
        <aside class="reference-identity-note">
          <strong>Guest status attributes</strong>
          <p>When replication applies, VM and CT Status can also expose <code>replication_status</code>, <code>replication_jobs</code>, <code>replication_failed_jobs</code> and <code>replication</code>.</p>
        </aside>
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>

      <section id="entities-devices-availability" class="reference-section" aria-labelledby="entities-devices-availability-title">
        <div class="reference-section__heading">
          <h2 id="entities-devices-availability-title">Entities, Devices & Availability</h2>
          <span>{identityAvailabilityEntryCount} topics</span>
        </div>
        <p class="reference-section__intro">Identity rules explain why entities remain stable across migrations and why conditional families may not appear in every environment.</p>
        <ReferenceGuidance groups={identityAvailabilityGroups} />
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>

      <section id="troubleshooting" class="reference-section" aria-labelledby="troubleshooting-title">
        <div class="reference-section__heading">
          <h2 id="troubleshooting-title">Troubleshooting</h2>
          <span>{troubleshootingEntryCount} topics</span>
        </div>
        <p class="reference-section__intro">Use these checks to locate missing entities and understand environment-dependent Reference content.</p>
        <ReferenceGuidance groups={troubleshootingGroups} />
        <a class="getting-started-section__back" href="#reference-index">↑ Back to top</a>
      </section>
    </div>
  </div>
</DocumentationLayout>

<script define:vars={{ searchIndex, searchCopy, searchAliases }}>
  const search = document.querySelector("#reference-search-input");
  const suggestions = document.querySelector("[data-reference-suggestions]");
  const suggestionList = document.querySelector("#reference-suggestions");
  const empty = document.querySelector("#reference-empty");
  const status = document.querySelector("#reference-search-status");

  if (search && suggestions && suggestionList && empty && status) {
    let activeIndex = -1;
    let matches = [];
    const normalize = (value) => value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase()
      .replace(/[^a-z0-9_]+/g, " ")
      .trim();
    const expandQuery = (query) => query.split(" ").map((term) => searchAliases[term] ?? term).join(" ");
    const score = (entry, query) => {
      const expanded = expandQuery(query);
      const name = normalize(entry.name);
      const identifier = normalize(entry.identifier);
      if (identifier === expanded || name === expanded) return 0;
      if (identifier.startsWith(expanded) || name.startsWith(expanded)) return 1;
      if (name.includes(expanded)) return 2;
      if (entry.attributes.some((attribute) => normalize(attribute) === expanded)) return 3;
      if (entry.attributes.some((attribute) => normalize(attribute).includes(expanded))) return 4;
      if (entry.searchText.includes(expanded)) return 5;
      const terms = expanded.split(" ").filter(Boolean);
      return terms.every((term) => entry.searchText.includes(term)) ? 6 : Number.POSITIVE_INFINITY;
    };
    const setActive = (nextIndex) => {
      const options = [...suggestionList.querySelectorAll("[role=option]")];
      activeIndex = options.length ? (nextIndex + options.length) % options.length : -1;
      options.forEach((option, index) => option.setAttribute("aria-selected", String(index === activeIndex)));
      const active = options[activeIndex];
      search.setAttribute("aria-activedescendant", active?.id ?? "");
      active?.scrollIntoView({ block: "nearest" });
    };
    const close = () => {
      suggestions.hidden = true;
      search.setAttribute("aria-expanded", "false");
      search.removeAttribute("aria-activedescendant");
      activeIndex = -1;
    };
    const navigate = (entry) => {
      close();
      search.value = "";
      status.textContent = `${searchIndex.length} ${searchCopy.results}`;
      if (entry.href.startsWith("#")) {
        const target = document.getElementById(entry.id);
        history.pushState(null, "", entry.href);
        target?.scrollIntoView({ behavior: "smooth", block: "start" });
        target?.focus({ preventScroll: true });
      } else {
        window.location.assign(entry.href);
      }
    };
    const render = () => {
      const query = normalize(search.value);
      suggestionList.replaceChildren();
      if (!query) {
        status.textContent = `${searchIndex.length} ${searchCopy.results}`;
        close();
        return;
      }

      matches = searchIndex
        .map((entry) => ({ entry, score: score(entry, query) }))
        .filter((match) => Number.isFinite(match.score))
        .sort((left, right) => left.score - right.score || left.entry.name.localeCompare(right.entry.name))
        .map((match) => match.entry);
      const shown = matches.slice(0, 8);
      shown.forEach((entry, index) => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        const heading = document.createElement("span");
        const module = document.createElement("strong");
        const name = document.createElement("span");
        const context = document.createElement("span");
        link.id = `reference-suggestion-${index}`;
        link.setAttribute("role", "option");
        link.setAttribute("aria-selected", "false");
        link.href = entry.href;
        module.className = "reference-suggestion__module";
        module.textContent = entry.module;
        name.className = "reference-suggestion__name";
        name.textContent = entry.label;
        heading.className = "reference-suggestion__heading";
        heading.append(module, name);
        context.className = "reference-suggestion__context";
        const matchingAttributes = entry.attributes.filter((attribute) => score({ ...entry, name: "", identifier: "", searchText: normalize(attribute), attributes: [attribute] }, query) < 6);
        context.textContent = matchingAttributes.length
          ? `${searchCopy.attributes}: ${matchingAttributes.slice(0, 2).join(", ")}`
          : `${entry.groupLabel} · ${entry.type}`;
        link.append(heading, context);
        link.addEventListener("click", (event) => {
          event.preventDefault();
          navigate(entry);
        });
        item.append(link);
        suggestionList.append(item);
      });
      empty.hidden = matches.length !== 0;
      suggestions.hidden = false;
      search.setAttribute("aria-expanded", "true");
      status.textContent = `${matches.length} ${matches.length === 1 ? searchCopy.result : searchCopy.results}`;
      activeIndex = -1;
    };

    search.addEventListener("input", render);
    search.addEventListener("focus", render);
    search.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === "Enter" && activeIndex >= 0) {
        event.preventDefault();
        navigate(matches.slice(0, 8)[activeIndex]);
      } else if (event.key === "Escape") {
        close();
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (!suggestions.contains(event.target) && event.target !== search) close();
    });
  }
</script>
