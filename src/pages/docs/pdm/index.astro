---
import NavIcon from "../../../components/NavIcon.astro";
import Overview from "../../../components/documentation/pdm/overview.md";
import Configuration from "../../../components/documentation/pdm/configuration.md";
import Authentication from "../../../components/documentation/pdm/authentication.md";
import DatacenterMonitoring from "../../../components/documentation/pdm/datacenter-monitoring.md";
import Remotes from "../../../components/documentation/pdm/remotes.md";
import Updates from "../../../components/documentation/pdm/updates.md";
import Troubleshooting from "../../../components/documentation/pdm/troubleshooting.md";
import { getDocumentationCategory } from "../../../data/documentation";
import { navigationItems } from "../../../data/navigation";
import DocumentationLayout from "../../../layouts/DocumentationLayout.astro";

const category = getDocumentationCategory("pdm");
const sections = [
  { id: "overview", ...category.topics[0], content: Overview },
  { id: "configuration", ...category.topics[1], content: Configuration },
  { id: "authentication", ...category.topics[2], content: Authentication },
  { id: "datacenter-monitoring", ...category.topics[3], content: DatacenterMonitoring },
  { id: "remotes", ...category.topics[4], content: Remotes },
  { id: "updates", ...category.topics[5], content: Updates },
  { id: "troubleshooting", ...category.topics[6], content: Troubleshooting },
];
const repositoryUrl = navigationItems.find((item) => item.label === "GitHub")?.href;
if (!repositoryUrl) throw new Error("Canonical integration repository link is missing");
const issuesUrl = `${repositoryUrl}/issues`;
---

<DocumentationLayout title="PDM Documentation" description={category.introduction} section="Documentation">
  <div class="pdm-guide">
    <nav id="pdm-index" class="getting-started-index" aria-labelledby="pdm-index-title">
      <div class="documentation-section-heading">
        <div>
          <p>On this page</p>
          <h2 id="pdm-index-title">Explore PDM</h2>
        </div>
        <span>{sections.length} sections</span>
      </div>

      <ol class="documentation-topic-grid getting-started-index__list">
        {sections.map((section, index) => (
          <li>
            <a class="documentation-topic-card getting-started-index__link" href={`#${section.id}`}>
              <span class="documentation-topic-card__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span>
                <strong>{section.title}</strong>
                <span>{section.description}</span>
              </span>
              <span class="documentation-topic-card__icon" aria-hidden="true">
                <NavIcon name={category.icon} size={17} />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="getting-started-articles">
      {sections.map((section) => {
        const Content = section.content;
        return (
          <section id={section.id} class="getting-started-section" aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <Content />
            {section.id === "troubleshooting" && (
              <p>
                If the problem persists after these checks, use the project's{" "}
                <a href={issuesUrl}>GitHub issue tracker</a>.
              </p>
            )}
            <a class="getting-started-section__back" href="#pdm-index">↑ Back to top</a>
          </section>
        );
      })}
    </div>
  </div>
</DocumentationLayout>
