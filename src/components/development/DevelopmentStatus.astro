---
interface Props {
  status: "idea" | "study" | "planned" | "development" | "testing" | "completed" | "paused" | "cancelled";
}

const { status } = Astro.props;
const labels = {
  idea: "Idea",
  study: "Study",
  planned: "Planned",
  development: "Development",
  testing: "Testing",
  completed: "Completed",
  paused: "Paused",
  cancelled: "Cancelled",
};
const symbols = {
  idea: "◇",
  study: "◎",
  planned: "▣",
  development: "◆",
  testing: "△",
  completed: "✓",
  paused: "Ⅱ",
  cancelled: "×",
};
---

<span class:list={["development-status", `development-status--${status}`]}>
  <span class="development-status__symbol" aria-hidden="true">{symbols[status]}</span>
  {labels[status]}
</span>
