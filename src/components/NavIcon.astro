---
import type { NavigationIcon } from "../data/navigation";

interface Props {
  name: NavigationIcon | "menu" | "close" | "external";
  size?: number;
}

const { name, size = 22 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "home" && <><path d="M3 10.8 12 3l9 7.8" /><path d="M5.5 9.5V21h13V9.5" /><path d="M9.5 21v-6h5v6" /></>}
  {name === "server" && <><rect x="3" y="4" width="18" height="6" rx="2" /><rect x="3" y="14" width="18" height="6" rx="2" /><path d="M7 7h.01M7 17h.01M11 7h7M11 17h7" /></>}
  {name === "backup" && <><ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5" /><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" /></>}
  {name === "cluster" && <><circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="18" r="2.5" /><circle cx="19" cy="18" r="2.5" /><path d="m10.7 7.2-4.4 8M13.3 7.2l4.4 8M7.5 18h9" /></>}
  {name === "dashboard" && <><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></>}
  {name === "docs" && <><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5z" /><path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5z" /></>}
  {name === "development" && <><path d="M4 19.5V15l8-8 5 5-8 8H4Z" /><path d="m14.5 4.5 2-2 5 5-2 2M12 7l5 5M4 15l5 5" /></>}
  {name === "install" && <><path d="M12 3v12M7 10l5 5 5-5" /><path d="M5 21h14" /></>}
  {name === "github" && <><path d="M8 19c-4.5 1.4-4.5-2.5-6-3" /><path d="M14 22v-3.9c0-1.1.1-1.6-.5-2.2 3-.3 6.1-1.5 6.1-6.6A5.1 5.1 0 0 0 18.2 5.7 4.7 4.7 0 0 0 18.1 2S17 1.6 14 3.4a13 13 0 0 0-6 0C5 1.6 3.9 2 3.9 2a4.7 4.7 0 0 0-.1 3.7 5.1 5.1 0 0 0-1.4 3.6c0 5.1 3.1 6.3 6.1 6.6-.5.5-.6 1-.5 2.2V22" /></>}
  {name === "menu" && <><path d="M4 6h16M4 12h16M4 18h16" /></>}
  {name === "close" && <><path d="m6 6 12 12M18 6 6 18" /></>}
  {name === "external" && <><path d="M15 4h5v5M20 4l-9 9" /><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" /></>}
</svg>
