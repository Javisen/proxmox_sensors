---
import NavIcon from "./NavIcon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { navigationItems } from "../data/navigation";
import { localizePath, stripLocaleFromPath, type Locale } from "../i18n/config";
import { ui, type UiKey } from "../i18n/ui";

interface Props {
  language?: Locale;
}

const { language = "en" } = Astro.props;
const labelKeys: Partial<Record<string, UiKey>> = {
  Home: "nav.home",
  Documentation: "nav.documentation",
  Development: "nav.development",
  Installation: "nav.installation",
  Cluster: "nav.cluster",
};
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;
const pathWithoutLocale = stripLocaleFromPath(currentPath, baseUrl);
const relativePath = pathWithoutLocale.startsWith(baseUrl)
  ? `/${pathWithoutLocale.slice(baseUrl.length)}`
  : pathWithoutLocale;

const withBase = (href: string) => {
  return localizePath(href, language, baseUrl);
};

const isActive = (href: string) =>
  href === "/" ? relativePath === "/" : relativePath.startsWith(href);
const labelFor = (label: string) => {
  const key = labelKeys[label];
  return key ? ui(language, key) : label;
};
const homeLabel = ui(language, "nav.home");
const primaryNavigationLabel = ui(language, "shell.primaryNavigation");
const externalLabel = ` (${ui(language, "shell.opensNewTab")})`;
---

<div class="sidebar-content">
  <a class="brand" href={baseUrl} aria-label={`Proxmox Extended Sensors — ${homeLabel}`}>
    <img src={`${baseUrl}assets/logo_int.png`} alt="" width="1024" height="344" />
    <span>Proxmox Extended Sensors</span>
  </a>

  <nav class="primary-navigation" aria-label={primaryNavigationLabel}>
    <ul>
      {navigationItems.map((item) => {
        const active = !item.external && isActive(item.href);
        return (
          <li>
            <a
              class:list={["navigation-link", { "is-active": active }]}
              href={item.external ? item.href : withBase(item.href)}
              aria-current={active ? "page" : undefined}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
            >
              <NavIcon name={item.icon} />
              <span>{labelFor(item.label)}</span>
              {item.external && (
                <span class="external-indicator">
                  <NavIcon name="external" size={15} />
                  <span class="visually-hidden">{externalLabel}</span>
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
  <LanguageSwitcher locale={language} />
</div>
