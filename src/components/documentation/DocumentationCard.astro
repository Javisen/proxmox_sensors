---
import NavIcon from "../NavIcon.astro";
import type { DocumentationCategory } from "../../data/documentation";
import { isLocale, localeFromPath, localizePath } from "../../i18n/config";
import { translate } from "../../i18n/content";

interface Props {
  category: DocumentationCategory;
}

const { category } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : localeFromPath(Astro.url.pathname);
const href = localizePath(category.href, locale, baseUrl);
---

<a class="documentation-card" href={href}>
  <span class="documentation-card__icon"><NavIcon name={category.icon} size={22} /></span>
  <span class="documentation-card__copy">
    <span class="documentation-card__heading">
      <strong>{translate(locale, category.title)}</strong>
      <span aria-hidden="true">›</span>
    </span>
    <span class="documentation-card__summary">{translate(locale, category.summary)}</span>
  </span>
</a>
