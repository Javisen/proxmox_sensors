---
import NavIcon from "../NavIcon.astro";
import type { DocumentationCategory } from "../../data/documentation";

interface Props {
  category: DocumentationCategory;
}

const { category } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const href = `${baseUrl}${category.href.replace(/^\//, "")}`;
---

<a class="documentation-card" href={href}>
  <span class="documentation-card__icon"><NavIcon name={category.icon} size={22} /></span>
  <span class="documentation-card__copy">
    <span class="documentation-card__heading">
      <strong>{category.title}</strong>
      <span aria-hidden="true">›</span>
    </span>
    <span class="documentation-card__summary">{category.summary}</span>
  </span>
</a>
