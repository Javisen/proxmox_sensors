---
import ContextNav from "../ContextNav.astro";
import { documentationCategories } from "../../data/documentation";
import { isLocale, localeFromPath, localizePath, stripLocaleFromPath } from "../../i18n/config";
import { translate } from "../../i18n/content";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : localeFromPath(currentPath);
const relativePath = stripLocaleFromPath(currentPath, baseUrl);
const withBase = (href: string) => localizePath(href, locale, baseUrl);
---

<ContextNav label={locale === "es" ? "Secciones de documentación" : "Documentation sections"}>
  <ul class="documentation-nav__list">
    {documentationCategories.map((category) => {
      const active = relativePath.startsWith(category.href);
      return (
        <li>
          <a
            class:list={["documentation-nav__link", { "is-active": active }]}
            href={withBase(category.href)}
            aria-current={active ? "page" : undefined}
          >
            {translate(locale, category.title)}
          </a>
        </li>
      );
    })}
  </ul>
</ContextNav>
