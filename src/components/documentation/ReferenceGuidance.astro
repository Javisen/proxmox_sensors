---
import type { ReferenceGuidanceGroup } from "../../data/reference";

interface Props {
  groups: ReferenceGuidanceGroup[];
}

const { groups } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (href: string) => `${baseUrl}${href.replace(/^\//, "")}`;
---

<div class="reference-guidance">
  {groups.map((group) => (
    <section class="reference-guidance__group" data-reference-group>
      <h3>{group.title}</h3>
      <div class="reference-guidance__items">
        {group.items.map((item) => (
          <article class="reference-guidance__item" data-reference-entry>
            <h4>{item.title}</h4>
            <p>{item.description}</p>
            {item.points && (
              <ul>
                {item.points.map((point) => <li>{point}</li>)}
              </ul>
            )}
            {item.link && <a href={withBase(item.link.href)}>{item.link.label}</a>}
          </article>
        ))}
      </div>
    </section>
  ))}
</div>
