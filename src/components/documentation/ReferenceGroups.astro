---
import type { ReferenceGroup } from "../../data/reference";
import ReferenceEntry from "./ReferenceEntry.astro";

interface Props {
  groups: ReferenceGroup[];
  headingLevel?: "h3" | "h4";
}

const { groups, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<div class="reference-groups">
  {groups.map((group) => (
    <div class="reference-group" data-reference-group>
      <Heading>{group.title}</Heading>
      <div class="reference-group__entries">
        {group.entries.map((entry) => <ReferenceEntry entry={entry} />)}
      </div>
    </div>
  ))}
</div>
